{
  "name": "store254-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ci-setup.mjs",
    "build": "node scripts/ci-setup.mjs",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "deploy:backend": "wrangler deploy --config backend/wrangler.toml --minify",
    "deploy:frontend": "cd frontend && npm run deploy",
    "test": "cd backend && npm test",
    "typecheck": "cd backend && npm run typecheck",
    "db:migrate:local": "cd backend && npm run db:migrate:local",
    "db:migrate:prod": "cd backend && npm run db:migrate:prod",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
