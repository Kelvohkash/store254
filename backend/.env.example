ENVIRONMENT=development
PRIMARY_DOMAIN=store254.co.ke
FRONTEND_ORIGINS=https://store254.co.ke,https://www.store254.co.ke
JWT_SECRET=super-secure-production-jwt-secret-replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-random-chars-refresh-secret
PLATFORM_ADMIN_USERNAME=replace-with-local-admin-username
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-local-admin-password
PLATFORM_ADMIN_JWT_SECRET=replace-with-a-long-random-secret
PAYMENT_CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-char-random-encryption-key
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://store254.co.ke/auth/google/callback
GOOGLE_MAPS_API_KEY=replace-with-google-maps-platform-api-key
MPESA_CONSUMER_KEY=replace-with-mpesa-consumer-key
MPESA_CONSUMER_SECRET=replace-with-mpesa-consumer-secret
MPESA_PASSKEY=replace-with-mpesa-passkey
MPESA_SHORTCODE=replace-with-mpesa-shortcode
MPESA_IS_SANDBOX=true
RESEND_API_KEY=replace-with-resend-api-key
GMAIL_SMTP_USER=replace-with-gmail-smtp-username@gmail.com
GMAIL_SMTP_PASS=replace-with-gmail-app-password
GMAIL_SENDER="Store254 Security <password_recovery@store254.co.ke>"
