{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store254-frontend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    { "binding": "API", "service": "store254-backend" }
  ],
  // Serve the platform and tenant shops on their own hostnames. API browser
  // requests are proxied by this Worker to keep each shop same-origin.
  "routes": [
    { "pattern": "store254.co.ke/*", "zone_name": "store254.co.ke" },
    { "pattern": "*.store254.co.ke/*", "zone_name": "store254.co.ke" }
  ]
}
