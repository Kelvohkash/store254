{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store254-frontend",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  // Serve landing page on root AND all tenant subdomains.
  // api.store254.co.ke/* is more specific and takes priority for the backend Worker.
  "routes": [
    { "pattern": "store254.co.ke/*", "zone_name": "store254.co.ke" },
    { "pattern": "*.store254.co.ke/*", "zone_name": "store254.co.ke" }
  ]
}
